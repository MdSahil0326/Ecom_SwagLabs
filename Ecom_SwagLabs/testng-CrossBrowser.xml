<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">

  <test name="ChromeTest">
    <parameter name="browser" value="chrome"/>
    <classes>
      <class name="ecom.swaglabs.Checkout.CheckoutNegative"/>
      <class name="ecom.swaglabs.Checkout.CheckoutPositive"/>
      <class name="ecom.swaglabs.Product.Product"/>
      <class name="ecom.swaglabs.AddtoCart.AddtoCart"/>
    </classes>
  </test>

  <test name="FirefoxTest">
    <parameter name="browser" value="firefox"/>
    <classes>
      <class name="ecom.swaglabs.Checkout.CheckoutNegative"/>
      <class name="ecom.swaglabs.Checkout.CheckoutPositive"/>
      <class name="ecom.swaglabs.Product.Product"/>
      <class name="ecom.swaglabs.AddtoCart.AddtoCart"/>
    </classes>
  </test>

  <test name="EdgeTest">
    <parameter name="browser" value="edge"/>
    <classes>
      <class name="ecom.swaglabs.Checkout.CheckoutNegative"/>
      <class name="ecom.swaglabs.Checkout.CheckoutPositive"/>
      <class name="ecom.swaglabs.Product.Product"/>
      <class name="ecom.swaglabs.AddtoCart.AddtoCart"/>
    </classes>
  </test>

</suite>